<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 480" width="400" height="480">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0a192f"/>
      <stop offset="50%" stop-color="#0f2b48"/>
      <stop offset="100%" stop-color="#06182c"/>
    </linearGradient>
    <linearGradient id="avatarGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3b82f6"/>
      <stop offset="100%" stop-color="#06b6d4"/>
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="40%" r="50%">
      <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.25"/>
      <stop offset="100%" stop-color="#06b6d4" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <!-- Background -->
  <rect width="400" height="480" rx="20" fill="url(#bg)"/>
  <rect x="1" y="1" width="398" height="478" rx="19" fill="none" stroke="#1e3d68" stroke-width="2"/>

  <!-- Subtle glow -->
  <circle cx="200" cy="180" r="160" fill="url(#glow)"/>

  <!-- Tech Grid Background lines -->
  <g opacity="0.1" stroke="#38bdf8" stroke-width="1">
    <line x1="40" y1="0" x2="40" y2="480"/>
    <line x1="120" y1="0" x2="120" y2="480"/>
    <line x1="200" y1="0" x2="200" y2="480"/>
    <line x1="280" y1="0" x2="280" y2="480"/>
    <line x1="360" y1="0" x2="360" y2="480"/>
    <line x1="0" y1="80" x2="400" y2="80"/>
    <line x1="0" y1="160" x2="400" y2="160"/>
    <line x1="0" y1="240" x2="400" y2="240"/>
    <line x1="0" y1="320" x2="400" y2="320"/>
    <line x1="0" y1="400" x2="400" y2="400"/>
  </g>

  <!-- Avatar Silhouette / Monogram -->
  <g transform="translate(200, 195)">
    <!-- Outer Ring -->
    <circle r="90" fill="#091a32" stroke="url(#avatarGrad)" stroke-width="3"/>
    <circle r="78" fill="#071426" stroke="#163456" stroke-width="1.5" stroke-dasharray="6,4"/>

    <!-- Professional silhouette head & shoulders -->
    <circle cx="0" cy="-20" r="32" fill="#1e3a5f"/>
    <path d="M -48,46 C -48,15 -25,12 0,12 C 25,12 48,15 48,46 Z" fill="#1e3a5f"/>

    <!-- Monogram Overlay -->
    <text x="0" y="5" font-family="'Plus Jakarta Sans', sans-serif" font-size="28" font-weight="800" fill="#ffffff" text-anchor="middle" letter-spacing="2">DD</text>
  </g>

  <!-- Overlay Badge -->
  <g transform="translate(200, 350)">
    <rect x="-110" y="0" width="220" height="34" rx="17" fill="#091c36" stroke="#06b6d4" stroke-width="1.5"/>
    <circle cx="-85" cy="17" r="4" fill="#10d9a0"/>
    <text x="5" y="22" font-family="'Fira Code', monospace" font-size="11" font-weight="600" fill="#e2e8f0" text-anchor="middle">Dhruvi Dave</text>
  </g>

  <!-- Subtitle -->
  <text x="200" y="415" font-family="'Plus Jakarta Sans', sans-serif" font-size="13" font-weight="600" fill="#94a3b8" text-anchor="middle">
    Backend &amp; Cloud DevOps Engineer
  </text>
  <text x="200" y="440" font-family="'Fira Code', monospace" font-size="10" fill="#38bdf8" text-anchor="middle">
    Replace with: public/dhruvi-photo.png
  </text>
</svg>
